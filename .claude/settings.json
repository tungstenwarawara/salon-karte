{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(python3 *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(sort *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(bash scripts/*)",
      "mcp__Claude_in_Chrome__get_page_text",
      "mcp__Claude_in_Chrome__read_console_messages",
      "mcp__Claude_in_Chrome__read_network_requests",
      "mcp__Claude_in_Chrome__read_page",
      "mcp__Claude_in_Chrome__find",
      "mcp__Claude_in_Chrome__list_tabs",
      "mcp__Claude_in_Chrome__tabs_context_mcp",
      "mcp__Claude_Preview__preview_snapshot",
      "mcp__Claude_Preview__preview_console_logs",
      "mcp__Claude_Preview__preview_logs",
      "mcp__Claude_Preview__preview_network",
      "mcp__Claude_Preview__preview_inspect",
      "mcp__Claude_Preview__preview_screenshot",
      "mcp__Claude_Preview__preview_list",
      "mcp__96b9b723-559c-4b76-ad5f-3544d6494788__list_migrations",
      "mcp__96b9b723-559c-4b76-ad5f-3544d6494788__list_tables",
      "mcp__96b9b723-559c-4b76-ad5f-3544d6494788__list_branches",
      "mcp__96b9b723-559c-4b76-ad5f-3544d6494788__list_projects",
      "mcp__96b9b723-559c-4b76-ad5f-3544d6494788__list_edge_functions",
      "mcp__96b9b723-559c-4b76-ad5f-3544d6494788__get_project",
      "mcp__96b9b723-559c-4b76-ad5f-3544d6494788__get_project_url",
      "mcp__96b9b723-559c-4b76-ad5f-3544d6494788__get_advisors",
      "mcp__96b9b723-559c-4b76-ad5f-3544d6494788__generate_typescript_types",
      "mcp__96b9b723-559c-4b76-ad5f-3544d6494788__search_docs"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git checkout . *)",
      "Bash(git restore . *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Write(.env)",
      "Write(.env.local)",
      "Write(.env.production)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.production)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": ".claude/hooks/statusline.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-check.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/warn-stale-plans.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-docs-sync.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/protect-migrations.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Codeが入力を待っています\" with title \"Claude Code\"'"
          }
        ]
      }
    ]
  }
}
